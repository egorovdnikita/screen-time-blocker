{
  "expo": {
    "name": "screen-time-blocker",
    "slug": "screen-time-blocker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.egorovdnikita.block",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.egorovdnikita.block"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "screen-time-blocker",
      "shortName": "screen-time-blocker",
      "lang": "ru",
      "description": "Прототип настройки экранного времени. Правила хранятся на устройстве; блокировка приложений пока недоступна."
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-notifications"
    ],
    "scheme": "block",
    "backgroundColor": "#f4f6f8",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "egorov_d_nikita",
    "extra": {
      "eas": {
        "projectId": "b939e29d-7990-4b6e-869e-0b9af11259b9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b939e29d-7990-4b6e-869e-0b9af11259b9"
    }
  }
